# Copy this to .env and fill in your own values

# Database
DATABASE_URL="postgresql+psycopg2://localhost/ai_opportunity_db"

# AI (required for chat)
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional: GitHub (higher rate limits)
GITHUB_TOKEN=""

# Optional: Reddit
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="ai-opportunity-platform/1.0"

# ChromaDB storage
CHROMA_PERSIST_DIR="./chroma_db"
